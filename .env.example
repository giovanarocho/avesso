# Copie cada linha pra Vercel → Settings → Environment Variables

# Endereço do site no ar, sem barra no final
SITE_URL=https://afetue.com.br

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago → Suas integrações → Credenciais de produção
MP_ACCESS_TOKEN=APP_USR-...
# Mercado Pago → Suas integrações → Webhooks → "Assinatura secreta"
MP_WEBHOOK_SECRET=

# Resend → API Keys. O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=re_...
EMAIL_FROM=afetue <ola@afetue.com.br>
# Pra onde vão os avisos de venda e de livro recebido
EMAIL_ADMIN=seu-email@exemplo.com
# Pra onde vão as respostas dos clientes (opcional; se vazio, usa EMAIL_ADMIN)
EMAIL_RESPOSTA=

# Senha do painel /admin (use uma senha longa, só sua)
ADMIN_SENHA=

# Preços, vagas, prazo e turma aberta/fechada agora ficam no painel /admin → "Preços e turma".
