# copie estas variáveis pra Vercel (Project Settings > Environment Variables)
# nunca coloque o access token de verdade neste arquivo nem suba ele pro github

# access token de PRODUÇÃO da sua conta mercado pago
# (Mercado Pago > seu perfil de desenvolvedor > suas integrações > credenciais de produção)
MP_ACCESS_TOKEN=

# preços — servem de valor inicial / reserva. depois de configurar o supabase
# (mais abaixo) e o painel /painel, o preço editado por lá passa a valer, e
# essas variáveis viram só uma reserva pro caso do banco cair. qualquer
# ferramenta nova do catálogo (lib/products.js) tem sua própria variável de
# preço, seguindo o mesmo padrão.
GUIA_PRICE=39.90
MOLDA_PRICE=29.90
BASE_PRICE=6000
MANUTENCAO_PRICE=1500
MANUTENCAO_VAGAS=restam poucas vagas por vez, pra dar atenção de verdade a cada cliente.

# ---------- banco de dados (supabase) — necessário pras contas ----------
# sem essas duas variáveis, o site funciona como página de venda, mas
# ninguém consegue criar conta nem comprar de verdade — é no supabase que
# ficam as contas (e-mail + senha) e o histórico de compras de cada uma.
#
# crie um projeto grátis em supabase.com, rode supabase_schema.sql e depois
# supabase_migration_contas.sql (os dois nesta mesma pasta) no SQL Editor,
# e pegue esses dois valores em Project Settings > API Keys (aba "legacy").
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# uma senha longa qualquer, só ela usa — assina as sessões de login de
# qualquer conta (serve pra todas as ferramentas). gere uma com
# "openssl rand -hex 32" no terminal, por exemplo. trocar esse valor
# derruba todas as sessões ativas de uma vez (todo mundo precisa logar de
# novo, mas as contas e senhas continuam intactas).
CONTA_SESSION_SECRET=

# ---------- opcional: e-mail automático + registro das vendas ----------
# sem preencher essas variáveis, o site funciona normalmente do mesmo
# jeito — só não manda e-mail nenhum (a pessoa só vê a tela depois do pix).

# resend: crie uma conta grátis em resend.com, verifique um domínio seu lá
# (Domains > Add Domain, seguindo as instruções de DNS que eles mostram),
# depois pegue a api key em API Keys > Create API Key.
RESEND_API_KEY=

# quem aparece como remetente do e-mail. o domínio depois do @ precisa ser
# um domínio verificado na sua conta resend.
RESEND_FROM=estúdio avesso <guia@oestudioavesso.com.br>

# endereço público do site (sem barra no final) — usado só pra montar os
# links clicáveis dentro dos e-mails. se você já configurou seu domínio, use ele:
SITE_URL=https://oestudioavesso.com.br

# ---------- painel administrativo (/painel) ----------
# senha pra entrar no painel — escolha algo forte, não tem limite de
# tentativas. só existe uma senha (não é usuário + senha, é só a senha).
# sem essa variável, a página /painel simplesmente não deixa ninguém entrar.
ADMIN_PASSWORD=

# opcional — se não preencher, usa o próprio ADMIN_PASSWORD como chave de
# assinatura das sessões do painel. só precisa mexer aqui se um dia quiser
# trocar a senha sem derrubar quem já está logado.
ADMIN_SECRET=
